# ==============================================================================
# Environment variables template.
#
# Copy this file to `.env.development` (local) or `.env.production`
# (production-like) before running the app. `src/config.py` loads
# `.env.<APP_ENV>`, where `APP_ENV` is read from the **OS environment**
# (set via the Makefile / your shell, defaulting to `development`).
# NOTE: `APP_ENV` is NOT read from this file — export it in your shell instead.
# ==============================================================================

# --- System Configuration ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- LLM Provider (Gemini) ---
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# --- Vector Database (Qdrant) ---
QDRANT_URL=http://localhost:6333
# Optional for a local Qdrant (Docker); required for Qdrant Cloud.
QDRANT_API_KEY=your_qdrant_api_key_here

# --- Relational Database (PostgreSQL) ---
# Format: postgresql://[user]:[password]@[host]:[port]/[db_name]
# Defaults below match `docker-compose.dev.yml`.
POSTGRES_URL=postgresql://legal_admin:super_secret_password@localhost:5432/legal_assistant_db

# --- LLMOps Observability (LangSmith) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT="asisten-legal-rag"

# --- Backend URL (used by the Chainlit UI) ---
# Defaults to http://127.0.0.1:7000 when unset.
BACKEND_URL=http://127.0.0.1:7000
